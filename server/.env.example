# Copiez ce fichier en .env et renseignez les valeurs avant de lancer le serveur.

# Port écouté par le serveur Express (défaut : 4000)
PORT=4000

# Chaîne de connexion à la base de données PostgreSQL (Prisma)
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BDD
DATABASE_URL="postgres://user:password@localhost:5432/fithnity"

# Secret utilisé pour signer les JWT (choisissez une chaîne longue et aléatoire)
JWT_SECRET="change-me-in-production-min-32-chars"

# Origines autorisées pour le CORS (séparées par des virgules)
# En développement (Angular) : http://localhost:4200
CORS_ORIGINS="http://localhost:4200"